NODE_ENV=development
HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgresql://ghostinc:ghostinc@localhost:5432/ghostinc
FRONTEND_ORIGIN=http://localhost:3002
PJUD_API_BASE_URL=http://localhost:18080/api/v1
PJUD_API_KEY=
API_KEY_PEPPER=change-this-for-a-random-secret-of-at-least-32-characters
INTERNAL_SERVICE_TOKEN=change-this-for-a-second-independent-random-secret
APP_BASE_URL=http://localhost:3002
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SESSION_ABSOLUTE_SECONDS=28800
SESSION_INACTIVITY_SECONDS=1800
SESSION_ROTATION_SECONDS=900
# TOTP_ENCRYPTION_KEY: 64 caracteres hexadecimales. Cambia en producción (no debe empezar con "deadbeef").
TOTP_ENCRYPTION_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef
# RECOVERY_CODE_PEPPER: secreto independiente de al menos 32 caracteres.
RECOVERY_CODE_PEPPER=change-this-for-a-third-independent-random-secret
# ADMIN_MFA_REAUTH_SECONDS: tiempo de gracia MFA para acciones administrativas.
ADMIN_MFA_REAUTH_SECONDS=1800
